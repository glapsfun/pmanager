{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun-types"]
  },
  "include": ["*.ts", "checks/**/*.ts", "e2e/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
